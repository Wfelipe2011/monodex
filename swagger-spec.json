        ],
        "summary": "Upsert completo de outreach config",
        "tags": [
          "Admin — Outreach Config"
        ]
      },
      "patch": {
        "description": "Altera só campos enviados (inclui outreachContactText, leadsPerRun, headerImageUrl, sendIntervalSeconds). enabled=true exige tenant pronto + outreachContactText e campos obrigatórios já persistidos.",
        "operationId": "OutreachConfigController_patch",
        "parameters": [
          {
            "name": "tenantId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
