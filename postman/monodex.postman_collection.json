    {
      "name": "Admin — Outreach Config",
      "item": [
        {
          "name": "Get Outreach Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gymBaseUrl}}/admin/tenants/{{tenantId}}/outreach-config"
          }
        },
        {
          "name": "Upsert Outreach Config (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"costPerLead\": 0.35,\n  \"cashbackOnReply\": 0,\n  \"outreachTemplateId\": {{templateId}},\n  \"notifyTemplateId\": {{templateId}},\n  \"slotBindings\": {\n    \"outreach\": {\n      \"body.1\": {\n        \"type\": \"literal\",\n        \"value\": \"Gladson Teixeira (contador em Pindamonhagaba)\"\n      },\n      \"header.image\": {\n        \"type\": \"header_image\",\n        \"value\": \"\"\n      }\n    },\n    \"notify\": {\n      \"body.customer_name\": {\n        \"type\": \"lead.name\"\n      },\n      \"body.customer_phone\": {\n        \"type\": \"lead.phone\"\n      },\n      \"body.customer_lead\": {\n        \"type\": \"literal\",\n        \"value\": \"customer_lead\"\n      }\n    }\n  },\n  \"schedule\": {\n    \"2\": [\n      18\n    ],\n    \"3\": [\n      18\n    ],\n    \"4\": [\n      13,\n      18\n    ]\n  },\n  \"categories\": [\n    \"Construtoras\",\n    \"Escritórios de advocacia\",\n    \"Clínicas médicas\",\n    \"Clínicas odontológicas\",\n    \"Consultórios\",\n    \"Estéticas\",\n    \"Consutorias\"\n  ],\n  \"leadsPerRun\": 5,\n  \"sendIntervalSeconds\": 5\n}"
            },
            "url": "{{gymBaseUrl}}/admin/tenants/{{tenantId}}/outreach-config",
            "description": "Templates = FKs do catalogo. `slotBindings.outreach` / `.notify` keyed por slot. `schedule`: dia da semana (0=Dom) → horas."
          }
        },
        {
          "name": "Patch Outreach Config",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"outreachTemplateId\": {{templateId}},\n  \"notifyTemplateId\": {{templateId}},\n  \"leadsPerRun\": 5,\n  \"slotBindings\": {\n    \"outreach\": {\n      \"body.1\": { \"type\": \"literal\", \"value\": \"Gladson Teixeira (contador em Pindamonhagaba)\" }\n    },\n    \"notify\": {\n      \"body.customer_name\": { \"type\": \"lead.name\" },\n      \"body.customer_phone\": { \"type\": \"lead.phone\" },\n      \"body.customer_lead\": { \"type\": \"literal\", \"value\": \"customer_lead\" }\n    }\n  }\n}"
            },
            "url": "{{gymBaseUrl}}/admin/tenants/{{tenantId}}/outreach-config"
          }
        }
      ]
