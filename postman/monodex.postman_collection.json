        {
          "name": "Create Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('tenantId', String(json.id));",
                  "  if (json.uuid) pm.collectionVariables.set('tenantUuid', json.uuid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Academia Centro\",\n  \"phone\": \"15999998888\",\n  \"active\": true\n}"
            },
            "url": "{{gymBaseUrl}}/admin/tenants",
            "description": "`phone` é o número que recebe o notify do tenant (sem +55 obrigatório no código — o notifly prefixa 55)."
          }
        },
        {
          "name": "Get Tenant",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gymBaseUrl}}/admin/tenants/{{tenantId}}"
          }
